# YardLens API configuration. Copy to `.env` and adjust. All variables are optional.

# PostgreSQL connection (SQLAlchemy URL). The database and schema are created by
# `uv run db-setup` (db/schema.sql), which `bun run setup` runs.
YARDLENS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yardlens

# Comma-separated list of allowed browser origins (the web app).
YARDLENS_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

YARDLENS_HOST=127.0.0.1
YARDLENS_PORT=8100
YARDLENS_LOG_LEVEL=INFO
YARDLENS_LOG_JSON=false

# Runtime data: snapshots, model weights, sample videos.
YARDLENS_DATA_DIR=data

# Detection model used on first start (later changed from Settings → Detection).
YARDLENS_DEFAULT_MODEL=yolo26n.pt
# auto (NVIDIA GPU, then Apple Metal, else the CPU) | cpu | cuda:0 | mps | intel:gpu
YARDLENS_INFERENCE_DEVICE=auto
# auto (OpenVINO on the CPU, PyTorch on GPUs) | pytorch | openvino
YARDLENS_INFERENCE_BACKEND=auto
# CPU threads for inference; 0 picks them from the number of cores (2 on a 6-core CPU).
YARDLENS_INFERENCE_THREADS=0
# Decode camera video on the GPU (Intel Quick Sync, NVIDIA, AMD) where possible.
YARDLENS_HARDWARE_DECODE=true
# Run below normal priority so the OS, database and web app stay responsive under load.
YARDLENS_LOW_PRIORITY=true

YARDLENS_STREAM_JPEG_QUALITY=80
# Live view frame rate. Boxes from the latest inference are carried over to every frame.
YARDLENS_STREAM_FPS=15
YARDLENS_SNAPSHOT_MAX_WIDTH=960
# Frames wider than this are downscaled before inference, annotation and streaming.
YARDLENS_MAX_FRAME_WIDTH=1280
YARDLENS_EVENT_RETENTION_DAYS=7

# Loading bays: seconds a vehicle stands in the zone before it counts as arrived, and seconds
# with neither a vehicle nor cargo before it counts as gone.
YARDLENS_LOADING_ARRIVE_SECONDS=15
YARDLENS_LOADING_DEPART_SECONDS=60
