# YardLens server settings for docker compose. Copy to .env and fill in.

# This server's address on the network: an IP address or a host name. People open
# https://<PUBLIC_HOST>.
PUBLIC_HOST=192.168.1.10

# The administrator, created on the first start. The password can be changed in the dashboard
# afterwards (at least 10 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# The database password: any long random string, e.g. from `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# The release to run.
YARDLENS_VERSION=0.1.0

# Time zone for the logs.
TZ=Asia/Tashkent
