# HTTPS in front of YardLens on the local network.
#
# Caddy issues the certificates from its own certificate authority (`tls internal`). Install that
# CA once on each device that opens the dashboard (Settings > System > Download certificate);
# workers trust it through the fingerprint in their command. With a real domain later, delete
# `tls internal` and Caddy gets a public certificate by itself.
{
	# Clients connecting by IP address send no server name; this is the one they mean.
	default_sni {$PUBLIC_HOST}
	skip_install_trust
}

{$PUBLIC_HOST}, localhost {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# Live video, the event stream and the worker channel go out as they come, uncompressed.
	@compressible not path /api/cameras/*/stream.mjpeg /api/events/stream /api/workers/connect
	encode @compressible zstd gzip

	handle /api/* {
		reverse_proxy api:8100 {
			flush_interval -1
		}
	}
	handle /media/* {
		reverse_proxy api:8100
	}
	handle {
		reverse_proxy web:3100
	}
}
