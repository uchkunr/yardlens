# YardLens dashboard. Build it first (`bun run build`), then install as described in
# yardlens-api.service.

[Unit]
Description=YardLens dashboard
After=network-online.target yardlens-api.service
Wants=network-online.target

[Service]
Type=simple
User=yardlens
WorkingDirectory=/opt/yardlens/apps/web
# Bun from the official installer lives in ~/.bun/bin; adjust if it is elsewhere.
ExecStart=/home/yardlens/.bun/bin/bun run start
Environment=NODE_ENV=production
Restart=always
RestartSec=5

CPUQuota=100%
MemoryMax=1G
Nice=5

[Install]
WantedBy=multi-user.target
